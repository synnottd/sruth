# PostgreSQL (docker-compose)
POSTGRES_USER=omega
POSTGRES_PASSWORD=omega
POSTGRES_DB=omega_stream
POSTGRES_PORT=5432

# Redis (docker-compose)
REDIS_PORT=6379

# Connection strings (apps/api)
DATABASE_URL=postgresql://omega:omega@localhost:5432/omega_stream
REDIS_URL=redis://localhost:6379

# API server
PORT=3000
INTERNAL_PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=dev-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
AUTH_RATE_LIMIT_MAX=10

# Internal service auth
INTERNAL_SECRET=dev-internal-secret

# Ingest
INGEST_URL_BASE=rtmp://localhost:1935/live
API_HOST=host.docker.internal:3001

# Worker (optional)
# SQS_QUEUE_URL=
