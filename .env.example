# PostgreSQL (docker-compose)
POSTGRES_USER=sruth
POSTGRES_PASSWORD=sruth
POSTGRES_DB=sruth
POSTGRES_PORT=5432

# Connection strings
DATABASE_URL=postgresql://sruth:sruth@localhost:5432/sruth

# API server
PORT=3000
INTERNAL_PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3002

# Auth
JWT_SECRET=dev-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
AUTH_RATE_LIMIT_MAX=10

# Internal service auth (shared by API internal routes, ingest callbacks,
# and the worker's SSE endpoint)
INTERNAL_SECRET=dev-internal-secret

# Ingest
INGEST_URL_BASE=rtmp://localhost:1935/live
API_HOST=host.docker.internal:3001
INGEST_IP_OVERRIDE=127.0.0.1

# Worker
WORKER_URL=http://localhost:4000
