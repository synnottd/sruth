(security_headers) {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    header X-Frame-Options DENY
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
    header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
}

(web_csp) {
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.sruth.live; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
}

sruth.live {
    encode gzip zstd
    import security_headers
    import web_csp

    @landing path / /favicon.svg
    handle @landing {
        root * /srv/landing
        file_server
        header Cache-Control "public, max-age=300"
    }

    @me remote_ip {$ADMIN_ALLOWED_IPS}
    handle @me {
        reverse_proxy web:3002
    }

    handle {
        respond 404
    }
}

api.sruth.live {
    import security_headers

    @me remote_ip {$ADMIN_ALLOWED_IPS}
    handle @me {
        reverse_proxy api:3000
    }

    handle {
        respond 404
    }
}

# bidding-practice app — runs in a sibling compose stack (repo: dave/bidding,
# deployed to /opt/bidding). We reach it over the external `caddy-net` Docker
# network; the `bidding` service in that stack publishes nothing on the host.
# Public — no remote_ip allowlist, unlike sruth.live / api.sruth.live above.
bidding.sruth.live {
    encode gzip zstd
    import security_headers

    reverse_proxy bidding:3000
}
