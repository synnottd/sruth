{
  "name": "@sruth/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:push": "dotenv -e ../../.env -- prisma db push --config prisma/prisma.config.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio --config prisma/prisma.config.ts",
    "db:generate": "dotenv -e ../../.env -- prisma generate --config prisma/prisma.config.ts",
    "db:seed": "dotenv -e ../../.env -- prisma db seed --config prisma/prisma.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@sruth/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "prisma": "^7.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
