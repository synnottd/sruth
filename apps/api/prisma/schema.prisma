generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  twitch
  youtube
  facebook
  custom
}

enum OutputSessionStatus {
  starting
  live
  error
  stopped
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  streamKey    String    @unique @default(uuid())
  tenantId     String?
  createdAt    DateTime  @default(now())

  outputs        Output[]
  streamSessions StreamSession[]

  @@index([streamKey])
}

model Output {
  id        String   @id @default(uuid())
  userId    String
  name      String
  platform  Platform
  rtmpUrl   String
  streamKey String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  outputSessions OutputSession[]

  @@index([userId])
}

model StreamSession {
  id          String    @id @default(uuid())
  userId      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  avgBitrate  Int?
  peakBitrate Int?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  outputSessions OutputSession[]

  @@index([userId])
  @@index([startedAt])
}

model OutputSession {
  id             String              @id @default(uuid())
  sessionId      String
  outputId       String
  status         OutputSessionStatus @default(starting)
  lastError      String?
  reconnectCount Int                 @default(0)
  startedAt      DateTime            @default(now())
  endedAt        DateTime?

  session StreamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  output  Output        @relation(fields: [outputId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([outputId])
}
