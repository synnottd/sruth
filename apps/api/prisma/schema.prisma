generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  streamKey    String          @unique @default(uuid())
  createdAt    DateTime        @default(now())
  deletedAt    DateTime?
  outputs      Output[]
  sessions     StreamSession[]
}

enum Platform {
  TWITCH
  YOUTUBE
  FACEBOOK
  CUSTOM
}

model Output {
  id             String          @id @default(uuid())
  userId         String
  name           String
  platform       Platform
  rtmpUrl        String
  streamKey      String
  enabled        Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  user           User            @relation(fields: [userId], references: [id])
  outputSessions OutputSession[]

  @@unique([userId, streamKey])
  @@index([userId])
}

enum SessionStatus {
  STARTING
  LIVE
  ERROR
  STOPPED
}

model StreamSession {
  id             String          @id @default(uuid())
  userId         String
  status         SessionStatus   @default(STARTING)
  startedAt      DateTime        @default(now())
  endedAt        DateTime?
  avgBitrate     Float?
  peakBitrate    Float?
  user           User            @relation(fields: [userId], references: [id])
  outputSessions OutputSession[]

  @@index([userId])
  @@index([startedAt])
}

model OutputSession {
  id             String        @id @default(uuid())
  sessionId      String
  outputId       String
  status         SessionStatus @default(STARTING)
  lastError      String?
  reconnectCount Int           @default(0)
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  session        StreamSession @relation(fields: [sessionId], references: [id])
  output         Output        @relation(fields: [outputId], references: [id])

  @@index([sessionId])
  @@index([outputId])
}
