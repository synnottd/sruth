generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider    = "prisma-erd-generator"
  output      = "../../../docs/erd.md"
  theme       = "neutral"
  disableEmoji = true
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  streamKey    String    @unique @default(uuid())
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  outputs        Output[]
  streamSessions StreamSession[]
  refreshTokens  RefreshToken[]
}

enum Platform {
  TWITCH
  YOUTUBE
  FACEBOOK
  CUSTOM
}

enum StreamSessionStatus {
  STARTING
  LIVE
  ERROR
  STOPPED
}

enum OutputSessionStatus {
  STARTING
  LIVE
  ERROR
  STOPPED
}

model Output {
  id        String    @id @default(uuid())
  userId    String
  name      String
  platform  Platform
  rtmpUrl   String
  streamKey String
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  outputSessions OutputSession[]

  @@index([userId])
}

model StreamSession {
  id          String              @id @default(uuid())
  userId      String
  status      StreamSessionStatus @default(STARTING)
  startedAt   DateTime            @default(now())
  endedAt     DateTime?
  avgBitrate  Float?
  peakBitrate Float?
  ingestIp    String?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  outputSessions OutputSession[]

  @@index([userId])
  @@index([startedAt])
}

model OutputSession {
  id             String              @id @default(uuid())
  sessionId      String
  outputId       String
  status         OutputSessionStatus @default(STARTING)
  lastError      String?
  reconnectCount Int                 @default(0)
  startedAt      DateTime            @default(now())
  endedAt        DateTime?

  session StreamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  output  Output        @relation(fields: [outputId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([outputId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenId   String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum WorkerCommandStatus {
  PENDING
  CLAIMED
  DONE
  FAILED
}

model WorkerCommand {
  id          String              @id @default(uuid())
  payload     Json
  status      WorkerCommandStatus @default(PENDING)
  claimedAt   DateTime?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime            @default(now())

  @@index([status, createdAt])
}
