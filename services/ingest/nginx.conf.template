worker_processes auto;
rtmp_auto_push on;
error_log /dev/stderr warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

rtmp {
    server {
        listen 1935;
        chunk_size 4096;

        application live {
            live on;
            record off;

            notify_method post;
            on_publish http://${API_HOST}/internal/stream/on-publish;
            on_publish_done http://${API_HOST}/internal/stream/on-publish-done;
        }
    }
}

http {
    server {
        listen 8080;

        # Access controlled by security group (VPC-internal only, not exposed via NLB)
        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }

        location /health {
            return 200 "ok\n";
        }
    }
}
