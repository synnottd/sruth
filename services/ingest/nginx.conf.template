worker_processes auto;
rtmp_auto_push on;
error_log /dev/stderr warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

rtmp {
    server {
        listen 1935;
        chunk_size 4096;

        application live {
            live on;
            record off;

            notify_method post;
            on_publish http://127.0.0.1:8080/callbacks/on-publish;
            on_publish_done http://127.0.0.1:8080/callbacks/on-publish-done;
        }
    }
}

http {
    server {
        listen 8080;

        # Access controlled by security group (VPC-internal only, not exposed via NLB)
        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }

        location /health {
            return 200 "ok\n";
        }

        # Proxy nginx-rtmp callbacks to the API, injecting the secret as a header.
        # nginx-rtmp on_publish cannot send custom headers, so we bounce through
        # a local HTTP location that adds X-Internal-Secret via proxy_set_header.
        location /callbacks/on-publish {
            proxy_pass http://${API_HOST}/internal/stream/on-publish;
            proxy_set_header X-Internal-Secret ${INTERNAL_SECRET};
            proxy_set_header Host $host;
        }

        location /callbacks/on-publish-done {
            proxy_pass http://${API_HOST}/internal/stream/on-publish-done;
            proxy_set_header X-Internal-Secret ${INTERNAL_SECRET};
            proxy_set_header Host $host;
        }
    }
}
