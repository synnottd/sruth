{
  "name": "@sruth/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:up": "docker compose up -d --wait",
    "test:integration:down": "docker compose down",
    "db:generate": "dotenv -e ../../.env -- prisma generate --config prisma/prisma.config.ts"
  },
  "dependencies": {
    "@sruth/shared": "workspace:*",
    "@prisma/client": "^7.6.0",
    "@prisma/adapter-pg": "^7.6.0",
    "pg": "^8.20.0",
    "fastify": "^5.8.4"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "tsx": "^4.21.0",
    "vitest": "^4.1.2",
    "@types/node": "^25.5.2",
    "prisma": "^7.6.0",
    "@types/pg": "^8.20.0"
  }
}
